# KiCad ------------------------------------------------------------------
# Auto-generated backups and caches
*-backups/
_autosave-*
*.kicad_sch-bak
*.kicad_pcb-bak
fp-info-cache
*.net

# Lock files from a running KiCad instance
~*.lck
*.lck

# Local project state (window layout, last-opened, per-user settings)
*.kicad_prl

# Our own timestamped safety copies
*.pre-nrf-*.bak
*.bak

# Fabrication outputs - regenerate rather than commit
/gerbers/
/jlcpcb/
/production/
*.zip
*.drl
*.gbr

# Vendor datasheets - kept on disk, not in history. They are large, they are
# not ours, and they are all re-fetchable. doc/datasheets/README.md is tracked
# and records the exact revision of each, which is the part that matters.
# *.txt alongside them are pdftotext extractions for grepping - derived, and
# regenerable with `pdftotext -layout foo.pdf foo.txt`.
/doc/datasheets/*.pdf
/doc/datasheets/*.txt

# macOS -------------------------------------------------------------------
.DS_Store
._*

# Python ------------------------------------------------------------------
__pycache__/
*.pyc
.venv/

# Firmware build outputs --------------------------------------------------
/firmware/carrier-bringup/build/
/firmware/carrier-bringup/build-*/

# VS Code Local History extension (it is its own git repo)
.history/
.drutest/

# Fingerprint of the copper tools_route.py last wrote. Local state - it says
# what THIS checkout's board looks like, not what the design is.
.routed-by-script

# Local scratch, supplier cache, and regenerable visualization outputs.
# Selected output source scripts and notes are tracked explicitly.
/tmp/
/.easyeda_cache/
/output/
