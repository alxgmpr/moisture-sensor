/*
 * T3 — negative control on the same-port rule.
 *
 * SCL = P1.11  clock pin, peripheral domain
 * SDA = P0.04  clock pin, LOW-POWER domain
 *
 * Both pins are clock pins, so the only rule violated is the port crossing:
 * §8.8.3 says peripherals must use pins in their own domain and "cannot mix
 * pins from different ports". i2c22 is a peripheral-domain instance (TWIM20-22
 * live there; TWIM30 is the low-power-domain instance that owns P0), so P0.04
 * is out of its reach.
 *
 * P0.04 is Button 3 — chosen over P0.02 because P0.00-P0.03 are claimed by
 * uart30, which the board DTS enables. (The Zephyr console is uart20 on
 * P1.04/P1.05, not the P0 UART.) Do not press Button 3 during the run.
 *
 * i2c22 rather than i2c20: UARTE20 and TWIM20 are the same peripheral
 * instance, and uart20 is the console.
 *
 * This builds clean under NCS v3.2.2 — neither dtc nor the pinctrl layer
 * rejects the port crossing. Whatever enforces §8.8.3 does so in silicon, so
 * this is a runtime test.
 */

#include <zephyr/dt-bindings/i2c/i2c.h>

&pinctrl {
	i2c22_test_default: i2c22_test_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SCL, 1, 11)>,
				<NRF_PSEL(TWIM_SDA, 0, 4)>;
		};
	};

	i2c22_test_sleep: i2c22_test_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SCL, 1, 11)>,
				<NRF_PSEL(TWIM_SDA, 0, 4)>;
			low-power-enable;
		};
	};
};

&i2c22 {
	status = "okay";
	pinctrl-0 = <&i2c22_test_default>;
	pinctrl-1 = <&i2c22_test_sleep>;
	pinctrl-names = "default", "sleep";
	clock-frequency = <I2C_BITRATE_FAST>;
};

&button3 {
	status = "disabled";
};

/ {
	aliases {
		testbus = &i2c22;
	};
};
