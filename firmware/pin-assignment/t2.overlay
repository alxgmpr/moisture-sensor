/*
 * T2 — negative control on the clock-pin rule.
 *
 * SCL = P1.14  NOT a clock pin (the QFAA table marks only P1.03, P1.04,
 *              P1.08, P1.11, P1.12 on this port)
 * SDA = P1.10  unchanged from T1
 *
 * Still on P1, so the port rule is satisfied and only the clock-pin rule is
 * violated. That isolation is the point — if this passes, Table 77 does not
 * mean what HARDWARE.md §6 says it means.
 *
 * P1.14 is LED 3, another FET gate behind 1 MΩ. It is used in preference to
 * P1.09 — the pin the original guess actually used — because P1.09 is
 * Button 1 on the DK, and a pressed button shorts SCL to ground, which would
 * produce a failure that proves nothing. To test the historically exact pin
 * instead, swap 14 for 9 below and do not touch Button 1 during the run.
 */

&pinctrl {
	i2c22_test_default: i2c22_test_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SCL, 1, 14)>,
				<NRF_PSEL(TWIM_SDA, 1, 10)>;
		};
	};

	i2c22_test_sleep: i2c22_test_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SCL, 1, 14)>,
				<NRF_PSEL(TWIM_SDA, 1, 10)>;
			low-power-enable;
		};
	};
};

&i2c22 {
	status = "okay";
	pinctrl-0 = <&i2c22_test_default>;
	pinctrl-1 = <&i2c22_test_sleep>;
	pinctrl-names = "default", "sleep";
	clock-frequency = <I2C_BITRATE_FAST>;
};

&led1 {
	status = "disabled";
};

&led3 {
	status = "disabled";
};

/ {
	aliases {
		testbus = &i2c22;
	};
};
