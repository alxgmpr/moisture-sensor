/*
 * T4a — wake from P0.04, the low-power domain.
 *
 * P0.04 is Button 3 on the DK, so the wake source is a physical button:
 * active low, idle high through the internal pull-up. Our actual pin is
 * P0.00, but the board DTS gives that to uart30. The claim under test is
 * about the port, not the pin.
 *
 * button3 is disabled so the input driver does not also claim it.
 */

&button3 {
	status = "disabled";
};

/ {
	zephyr,user {
		wake-gpios = <&gpio0 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
	};
};
