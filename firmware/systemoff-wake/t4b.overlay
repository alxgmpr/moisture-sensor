/*
 * T4b — the same request on P2, which Table 40 says cannot wake.
 *
 * P2.08 is Trace[1], brought out on header P2 by default and carrying no LED
 * and no external flash. Pull it up internally and short it to ground by hand
 * to attempt a wake.
 *
 * Expect gpio_pin_interrupt_configure() to return -ENOTSUP before it gets
 * that far: P2 has no SENSE/DETECT and no GPIOTE, so there is nothing to arm.
 */

/ {
	zephyr,user {
		wake-gpios = <&gpio2 8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
	};
};
