	(footprint "footprints:NetTie_VSSPA"
		(layer "F.Cu")
		(uuid "e6545625-135e-497f-ab02-34c7dca035fd")
		(at 76.4 60.555)
		(descr "Net tie sized to bridge the nRF54L15 QFN48 pin-32 land to the centre pad. Nordic requires VSS_PA (pin 32) to reach pin 49 ONLY underneath the package, so the bridge has to live in the 0.1905 mm annulus between the perimeter land (inner edge 2.540 mm from centre) and the thermal land (edge 2.3495 mm from centre). A stock NetTie-2_SMD_Pad0.5mm does not fit there. Origin is the centre of that gap. Pad 1 GND_PA overlaps the pin-32 land, pad 2 GND overlaps the centre pad. Pad width matches pin 32 at 0.2032 mm.")
		(tags "net-tie RF VSS_PA nRF54L15")
		(property "Reference" "NT1"
			(at 1.4 0 0)
			(layer "F.Fab")
			(uuid "780d253f-1db3-4aac-8bde-a2aa1709e062")
